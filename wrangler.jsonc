{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-math-book",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": true,
  // Static site only: serve Astro's build output directly, no Worker script or adapter needed.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
